.build/
.swiftpm/
.vscode/
.liter8/
# Same role as .liter8/ for an explicitly named work directory: extracted IPSW
# components, decrypted rootfs images and their mounts. Tens of GB of Apple
# firmware that must never be committed.
.ios27/
.setup-cache/
.irecovery
__pycache__/
*.pyc
tools/idevicerestore
tools/.idevicerestore-commit
tools/*.setup-new
# Per-build workflow run directories.
.run-*/

# Local arm64/arm64e device-helper products. Provisioning rebuilds these from
# the reviewed Objective-C sources before copying them to the phone.
device/photoforce/pfruntimeprobe
device/photoforce/pfwatch
device/ddiwatch/ddiwatch
device/boothelper/l8boot
.ios272/
.ios272b2/

# macOS Finder metadata. Not content, and it churns on every directory view.
.DS_Store
# Built by device/launchdhook/build.sh, reproduced from source each run.
device/launchdhook/lhook.dylib
device/launchdhook/systemhook.dylib
device/launchdhook/sbextissue
# Built by device/pairingfix/build.sh, reproduced from source each run.
device/pairingfix/l8pair.dylib
# Built by device/coreauthfix/build.sh, reproduced from source each run.
device/coreauthfix/l8coreauth.dylib
# Built by device/remotexpcfix/build.sh, reproduced from source each run.
device/remotexpcfix/l8remotepairing.dylib
# Built by device/fdrfix/build.sh, reproduced from source each run.
device/fdrfix/l8fdr.dylib
device/keychainprobe/l8keychain.dylib
device/acmucfix/l8acmuc.dylib
device/fdrfix/l8radio
# Built by device/wififix/build.sh, reproduced from source each run.
device/wififix/l8wifi.dylib
# Built by device/launchdhook/build.sh, reproduced from source each run.
device/launchdhook/lhookctl
# Built by device/localauthfix/build.sh, reproduced from source each run.
device/localauthfix/l8localauth.dylib
# Built by device/personafix/build.sh, reproduced from source each run.
device/personafix/l8persona.dylib
# Host-built/downloaded device payloads; always reproduced by fetch_payloads.sh.
device/payload/
.run-ios272b4/
.ios272r/

# 27.3 beta 1 work dirs
.ios273/
.ios273-pro/
